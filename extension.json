{
    "name": "RestrictUserPageCreation",
    "author": "[https://consolemods.org/wiki/User:Derf Derf Jagged]",
    "version": "1.1",
    "url": "https://www.mediawiki.org/wiki/Extension:Restrict_User_Page_Creation",
    "description": "Prevents users from creating user pages or emailing users unless they have a specified number of edits.",
    "config": {
	"RestrictUserPageCreationEditThreshold": 2
    },
    "type": "extension",
    "Hooks": {
        "EditFilterMergedContent": "RestrictUserPageCreationHooks::onEditFilterMergedContent",
        "EmailUserAuthorizeSend": "RestrictUserPageCreationHooks::onEmailUserAuthorizeSend"
    },
    "MessagesDirs": {
        "RestrictUserPageCreation": [
            "i18n"
        ]
    },
    "AutoloadClasses": {
        "RestrictUserPageCreationHooks": "RestrictUserPageCreationHooks.php"
    },
    "requires": {
        "MediaWiki": ">= 1.35"
    },
    "manifest_version": 1
}
